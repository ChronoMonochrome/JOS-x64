KERN_SRCFILES := \
	kern/entry.S \
	kern/init.c \
	kern/console.c \
	kern/monitor.c \
	kern/printf.c \
	kern/kdebug.c

KERN_OBJFILES := $(patsubst kern/%.c, $(OBJDIR)/kern/%.o, $(filter %.c, $(KERN_SRCFILES)))
KERN_OBJFILES += $(patsubst kern/%.S, $(OBJDIR)/kern/%.o, $(filter %.S, $(KERN_SRCFILES)))

$(OBJDIR)/kern/%.o: kern/%.c
	@echo "+ cc $<"
	@mkdir -p $(@D)
	$(V)$(CC) $(KERN_CFLAGS) -c -o $@ $<

$(OBJDIR)/kern/%.o: kern/%.S
	@echo "+ as $<"
	@mkdir -p $(@D)
	$(V)$(CC) $(KERN_CFLAGS) -c -o $@ $<

# IMPORTANT: $(LIB_OBJFILES) must come AFTER $(KERN_OBJFILES)
$(OBJDIR)/kern/kernel: $(KERN_OBJFILES) $(LIB_OBJFILES) kern/kernel.ld
	@echo "+ ld $@"
	$(V)$(LD) $(LDFLAGS) -T kern/kernel.ld -o $@ $(KERN_OBJFILES) $(LIB_OBJFILES) $(GCC_LIB)
	$(V)$(OBJDUMP) -S $@ > $@.asm
	$(V)$(NM) -n $@ > $@.sym
