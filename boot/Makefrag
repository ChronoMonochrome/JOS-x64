OBJDIRS += boot

# We no longer build boot.o or main.o
# Instead, we download/copy the Limine binary
LIMINE_BIN := boot/limine

$(LIMINE_BIN):
	@echo "+ fetching limine binaries"
	$(V)mkdir -p boot
	$(V)rm -rf boot/limine_repo
	$(V)git clone https://github.com/limine-bootloader/limine.git --branch=v7.x-binary --depth=1 boot/limine_repo
	$(V)cp boot/limine_repo/limine-bios.sys boot/
	$(V)cp boot/limine_repo/limine-bios-cd.bin boot/
	$(V)cp boot/limine_repo/limine-uefi-cd.bin boot/
	$(V)cp boot/limine_repo/BOOTX64.EFI boot/
	$(V)$(CC) boot/limine_repo/limine.c -o boot/limine
	$(V)rm -rf boot/limine_repo
